# Estos son SOLO los NOMBRES de las variables. Sin valores.
# Los valores se pegan directo en Railway > tu servicio > Variables, nunca en este archivo ni en un chat.
# Si ves un archivo llamado .env (sin la palabra example), no lo abras ni lo subas a GitHub.

# --- Para publicar en Instagram ---
IG_TOKEN=
IG_USER_ID=

# --- Para publicar en tu Página de Facebook (opcional) ---
FB_PAGE_TOKEN=
FB_PAGE_ID=

# --- Para entrar a tu panel (una contraseña nueva que inventas tú, de 12 caracteres o más) ---
PANEL_CLAVE=

# --- La dirección pública de tu servicio en Railway, con https:// (la ves en Settings > Networking) ---
PUBLIC_URL=

# --- Para las respuestas a comentarios (opcional) ---
ANTHROPIC_API_KEY=
COMENTARIOS_ACTIVO=
COMENTARIOS_MODO=

# --- El interruptor: mientras esté vacío, el Publicador solo ensaya y NO publica ---
PUBLICAR_DE_VERDAD=

# --- Ajustes opcionales (déjalos vacíos si no sabes para qué sirven) ---
ZONA_HORARIA=
MODELO=
GRAPH_VERSION=
GRAPH_HOST=
HASHTAGS_MAXIMO=
TOLERANCIA_HORAS=
DATOS_DIR=

# --- Plantilla de IPESE (opcionales) ---
NEGOCIO_JSON=
RENOVAR_LLAVE_IG=
RENOVAR_LLAVE_CADA_DIAS=
